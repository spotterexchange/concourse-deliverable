# Optional. Without a key, "Ask a report" uses the keyword-rules parser.
CEREBRAS_API_KEY=
# Optional overrides (any OpenAI-compatible endpoint works).
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# Spend guards for the model (per serverless instance).
REPORT_DAILY_MODEL_CALLS=200
REPORT_MODEL_CALLS_PER_MIN=20
